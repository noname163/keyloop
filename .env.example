# Optional overrides. Docker Compose works without copying this file.
APP_PORT=8080

# PostgreSQL database created and used by Docker Compose.
POSTGRES_DB=keyloop
POSTGRES_USER=keyloop
POSTGRES_PASSWORD=replace-with-a-strong-password

# JDBC connection pool settings.
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=30000

# Upstream APIs used to retrieve sales and service documents.
SALES_SYSTEM_BASE_URL=https://6a7a6b608c69b3eb4a173191.mockapi.io/api/external/sales-service
SERVICE_SYSTEM_BASE_URL=https://6a7a6b608c69b3eb4a173191.mockapi.io/api/external/services-document
