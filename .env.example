# Copy this file to .env before deployment and replace the password.
APP_PORT=8080

# PostgreSQL database created and used by Docker Compose.
POSTGRES_DB=keyloop
POSTGRES_USER=keyloop
POSTGRES_PASSWORD=replace-with-a-strong-password

# JDBC connection pool settings.
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=30000

# Upstream APIs used to retrieve sales and service documents.
# host.docker.internal reaches services running on the Docker host.
SALES_SYSTEM_BASE_URL=http://host.docker.internal:8081
SERVICE_SYSTEM_BASE_URL=http://host.docker.internal:8082
